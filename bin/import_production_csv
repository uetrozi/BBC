#!/usr/bin/env bash
set -euo pipefail

if ! command -v op >/dev/null 2>&1; then
  echo "Error: 1Password CLI (op) is required."
  echo "Install: https://developer.1password.com/docs/cli/get-started/"
  exit 1
fi

if [[ $# -ne 1 ]]; then
  echo "Usage: bin/import_production_csv path/to/normalized.csv"
  exit 1
fi

csv_path="$1"

if [[ ! -f "$csv_path" ]]; then
  echo "Error: CSV file not found: $csv_path"
  exit 1
fi

database_url="$(op read 'op://Private/BBCX/render.com/database_url')"
master_key="$(op read 'op://Private/BBCX/render.com/master_key')"

if [[ -z "$database_url" || -z "$master_key" ]]; then
  echo "Error: Could not load DATABASE_URL or RAILS_MASTER_KEY from 1Password."
  exit 1
fi

echo "Running production CSV import via remote database URL..."
RAILS_ENV=production \
DATABASE_URL="$database_url" \
RAILS_MASTER_KEY="$master_key" \
bin/rails "bbcx:import[$csv_path]"
